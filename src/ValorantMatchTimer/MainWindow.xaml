<Window x:Class="ValorantMatchTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Valorant Match Timer"
        Width="430"
        SizeToContent="Height"
        MinWidth="400"
        MaxHeight="860"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Border Width="34"
                        Height="34"
                        CornerRadius="8"
                        Background="{StaticResource AccentBrush}"
                        Margin="0,0,10,0">
                    <TextBlock Text="V"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="VALORANT MATCH TIMER" Style="{StaticResource TitleText}" />
                    <TextBlock x:Name="SubtitleText"
                               Text="Watching for Valorant"
                               Style="{StaticResource MutedText}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot"
                         Width="8"
                         Height="8"
                         Fill="{StaticResource MutedBrush}"
                         Margin="0,0,6,0" />
                <TextBlock x:Name="StatusText"
                           Text="Idle"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           VerticalAlignment="Center" />
                <Button Content="&#x2699;"
                        Style="{StaticResource BaseButton}"
                        Width="34"
                        Height="34"
                        Padding="0"
                        Margin="10,0,0,0"
                        FontSize="15"
                        Click="Settings_Click" />
            </StackPanel>
        </Grid>

        <Border x:Name="GetOffCard" Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="TIME LEFT BEFORE YOU GET OFF PC" Style="{StaticResource LabelText}" />
                <TextBlock x:Name="GetOffText"
                           Text="—:—:—"
                           Style="{StaticResource TimerText}"
                           FontSize="40"
                           Margin="0,2,0,0" />
                <TextBlock x:Name="GetOffHint"
                           Text="Click the time to pick it with the wheel."
                           Style="{StaticResource MutedText}"
                           Margin="0,0,0,10" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Get off at"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <Button x:Name="ClockButton"
                            Grid.Column="1"
                            Style="{StaticResource TimeButton}"
                            Content="11:00 PM"
                            ToolTip="Click to choose a time"
                            Click="ClockButton_Click" />
                    <Button Grid.Column="2"
                            Content="+30m"
                            Style="{StaticResource BaseButton}"
                            Margin="6,0,0,0"
                            Click="Quick30_Click" />
                    <Button Grid.Column="3"
                            Content="+1h"
                            Style="{StaticResource BaseButton}"
                            Margin="6,0,0,0"
                            Click="Quick60_Click" />
                    <Button Grid.Column="5"
                            Content="Clear"
                            Style="{StaticResource BaseButton}"
                            Margin="6,0,0,0"
                            HorizontalAlignment="Right"
                            Click="ClearCutoff_Click" />

                    <Popup x:Name="TimePopup"
                           Grid.ColumnSpan="6"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=ClockButton}"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Slide"
                           HorizontalOffset="-10"
                           VerticalOffset="6"
                           Closed="TimePopup_Closed">
                        <Border Background="{StaticResource Card2Brush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="6" Color="Black" Opacity="0.55" />
                            </Border.Effect>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ListBox x:Name="HourList"
                                             Grid.Column="0"
                                             Style="{StaticResource WheelList}"
                                             SelectionChanged="TimeWheel_SelectionChanged"
                                             PreviewMouseWheel="WheelList_PreviewMouseWheel" />
                                    <ListBox x:Name="MinuteList"
                                             Grid.Column="1"
                                             Style="{StaticResource WheelList}"
                                             Margin="8,0,0,0"
                                             SelectionChanged="TimeWheel_SelectionChanged"
                                             PreviewMouseWheel="WheelList_PreviewMouseWheel" />
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                        <Button x:Name="AmButton"
                                                Content="AM"
                                                Style="{StaticResource BaseButton}"
                                                Width="46"
                                                Padding="6"
                                                Click="AmPm_Click" />
                                        <Button x:Name="PmButton"
                                                Content="PM"
                                                Style="{StaticResource BaseButton}"
                                                Width="46"
                                                Padding="6"
                                                Margin="0,6,0,0"
                                                Click="AmPm_Click" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,10,0,0">
                                    <Button Content="Cancel"
                                            Style="{StaticResource BaseButton}"
                                            Padding="9,5"
                                            Click="PickerCancel_Click" />
                                    <Button Content="Done"
                                            Style="{StaticResource AccentButton}"
                                            Padding="14,5"
                                            Margin="6,0,0,0"
                                            Click="PickerDone_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </StackPanel>
        </Border>

        <Border x:Name="MatchCard" Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <TextBlock Text="MATCH" Style="{StaticResource LabelText}" />
                    <TextBlock x:Name="MatchStatusText"
                               Text="Not in a match"
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Right" />
                </Grid>
                <TextBlock x:Name="MatchText"
                           Text="00:00"
                           Style="{StaticResource TimerText}"
                           FontSize="32"
                           Margin="0,2,0,0" />
                <TextBlock x:Name="MatchPredictionText"
                           Text="Pick a mode, then press Start for a manual timer."
                           Style="{StaticResource MutedText}"
                           TextWrapping="Wrap"
                           Margin="0,1,0,8" />
                <ProgressBar x:Name="MatchProgress"
                             Style="{StaticResource ThinProgress}"
                             Maximum="1000"
                             Value="0"
                             Margin="0,0,0,10" />

                <UniformGrid x:Name="ModeGrid" Columns="4" />

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Custom duration"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox x:Name="CustomDurationBox"
                             Grid.Column="1"
                             Style="{StaticResource InputBox}"
                             Text="35m"
                             TextAlignment="Center"
                             KeyDown="CustomDurationBox_KeyDown" />
                    <TextBlock Grid.Column="2"
                               Text="e.g. 35m, 1h 10m, 90"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Start timer"
                            Style="{StaticResource AccentButton}"
                            Click="StartTimer_Click" />
                    <Button Content="Stop"
                            Style="{StaticResource BaseButton}"
                            Margin="6,0,0,0"
                            Click="StopTimer_Click" />
                    <Button Content="Clear stats"
                            Style="{StaticResource BaseButton}"
                            Margin="6,0,0,0"
                            Click="ClearStats_Click" />
                </StackPanel>

                <TextBlock x:Name="PredictionText"
                           Style="{StaticResource MutedText}"
                           Foreground="{StaticResource GreenBrush}"
                           TextWrapping="Wrap"
                           Margin="0,9,0,0" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="ActivityText"
                   Grid.Row="3"
                   Style="{StaticResource MutedText}"
                   TextWrapping="Wrap"
                   Margin="2,0,2,8"
                   Text="Ready." />

        <Grid Grid.Row="4">
            <Button Content="Shutdown..."
                    Style="{StaticResource BaseButton}"
                    HorizontalAlignment="Right"
                    Click="ManualShutdown_Click" />
        </Grid>
    </Grid>
</Window>
