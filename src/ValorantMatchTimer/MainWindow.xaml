<Window x:Class="ValorantMatchTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Valorant Match Timer"
        Width="430"
        SizeToContent="Height"
        MinWidth="400"
        MaxHeight="860"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Border Width="34"
                        Height="34"
                        CornerRadius="8"
                        Background="{StaticResource AccentBrush}"
                        Margin="0,0,10,0">
                    <TextBlock Text="V"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="VALORANT MATCH TIMER" Style="{StaticResource TitleText}" />
                    <TextBlock x:Name="SubtitleText"
                               Text="Watching for Valorant"
                               Style="{StaticResource MutedText}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot"
                         Width="8"
                         Height="8"
                         Fill="{StaticResource MutedBrush}"
                         Margin="0,0,6,0" />
                <TextBlock x:Name="StatusText"
                           Text="Idle"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           VerticalAlignment="Center" />
                <Button Content="&#x2699;"
                        Style="{StaticResource BaseButton}"
                        Width="34"
                        Height="34"
                        Padding="0"
                        Margin="10,0,0,0"
                        FontSize="15"
                        Click="Settings_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="TIME LEFT BEFORE YOU GET OFF PC" Style="{StaticResource LabelText}" />
                <TextBlock x:Name="GetOffText"
                           Text="—:—:—"
                           Style="{StaticResource TimerText}"
                           FontSize="40"
                           Margin="0,2,0,0" />
                <TextBlock x:Name="GetOffHint"
                           Text="Set the clock time you need to stop."
                           Style="{StaticResource MutedText}"
                           Margin="0,0,0,10" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Get off at"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox x:Name="ClockBox"
                             Grid.Column="1"
                             Style="{StaticResource InputBox}"
                             Text="23:00"
                             TextAlignment="Center"
                             FontWeight="SemiBold"
                             KeyDown="ClockBox_KeyDown" />
                    <Button Grid.Column="2"
                            Content="Set"
                            Style="{StaticResource AccentButton}"
                            Margin="6,0,0,0"
                            Click="SetCutoff_Click" />
                    <Button Grid.Column="3"
                            Content="+30m"
                            Style="{StaticResource BaseButton}"
                            Margin="6,0,0,0"
                            Click="Quick30_Click" />
                    <Button Grid.Column="4"
                            Content="+1h"
                            Style="{StaticResource BaseButton}"
                            Margin="6,0,0,0"
                            Click="Quick60_Click" />
                    <Button Grid.Column="5"
                            Content="Clear"
                            Style="{StaticResource BaseButton}"
                            Margin="6,0,0,0"
                            HorizontalAlignment="Right"
                            Click="ClearCutoff_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <TextBlock Text="MATCH" Style="{StaticResource LabelText}" />
                    <TextBlock x:Name="MatchStatusText"
                               Text="Not in a match"
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Right" />
                </Grid>
                <TextBlock x:Name="MatchText"
                           Text="00:00"
                           Style="{StaticResource TimerText}"
                           FontSize="32"
                           Margin="0,2,0,0" />
                <TextBlock x:Name="MatchPredictionText"
                           Text="Pick a mode, then press Start for a manual timer."
                           Style="{StaticResource MutedText}"
                           TextWrapping="Wrap"
                           Margin="0,1,0,8" />
                <ProgressBar x:Name="MatchProgress"
                             Style="{StaticResource ThinProgress}"
                             Maximum="1000"
                             Value="0"
                             Margin="0,0,0,10" />

                <UniformGrid x:Name="ModeGrid" Columns="4" />

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Custom duration"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox x:Name="CustomDurationBox"
                             Grid.Column="1"
                             Style="{StaticResource InputBox}"
                             Text="35m"
                             TextAlignment="Center"
                             KeyDown="CustomDurationBox_KeyDown" />
                    <TextBlock Grid.Column="2"
                               Text="e.g. 35m, 1h 10m, 90"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Start timer"
                            Style="{StaticResource AccentButton}"
                            Click="StartTimer_Click" />
                    <Button Content="Stop"
                            Style="{StaticResource BaseButton}"
                            Margin="6,0,0,0"
                            Click="StopTimer_Click" />
                    <Button Content="Clear stats"
                            Style="{StaticResource BaseButton}"
                            Margin="6,0,0,0"
                            Click="ClearStats_Click" />
                </StackPanel>

                <TextBlock x:Name="PredictionText"
                           Style="{StaticResource MutedText}"
                           Foreground="{StaticResource GreenBrush}"
                           TextWrapping="Wrap"
                           Margin="0,9,0,0" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="ActivityText"
                   Grid.Row="3"
                   Style="{StaticResource MutedText}"
                   TextWrapping="Wrap"
                   Margin="2,0,2,8"
                   Text="Ready." />

        <Grid Grid.Row="4">
            <Button Content="Shutdown..."
                    Style="{StaticResource BaseButton}"
                    HorizontalAlignment="Right"
                    Click="ManualShutdown_Click" />
        </Grid>
    </Grid>
</Window>
