<Window x:Class="ValorantMatchTimer.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Valorant Match Timer Overlay"
        SizeToContent="WidthAndHeight"
        MinWidth="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        Focusable="False"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Root_MouseLeftButtonDown">
    <Border x:Name="Root"
            MinWidth="260"
            Background="#10131A"
            BorderBrush="#FF4655"
            BorderThickness="2"
            CornerRadius="10"
            Padding="14">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Border.LayoutTransform>
        <StackPanel>
            <Grid>
                <TextBlock x:Name="TimeLabel"
                           Text="GET OFF IN"
                           FontSize="9"
                           FontWeight="Bold"
                           Foreground="#8B93A7"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="ClockText"
                           Text="00:00"
                           FontSize="10"
                           Foreground="#8B93A7"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="TimeText"
                       Text="SET TIME"
                       FontFamily="Consolas"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#E8EDF5"
                       Margin="0,1,0,0" />
            <TextBlock x:Name="MatchText"
                       Text="No match detected"
                       FontSize="10"
                       Foreground="#8B93A7"
                       TextWrapping="Wrap"
                       Margin="0,1,0,0" />
            <TextBlock x:Name="SubText"
                       Text=""
                       FontSize="9"
                       Foreground="#8B93A7"
                       TextWrapping="Wrap"
                       Margin="0,3,0,0" />
        </StackPanel>
    </Border>
</Window>
