<Window x:Class="ValorantMatchTimer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Valorant Match Timer Settings"
        Width="820"
        Height="590"
        MinWidth="740"
        MinHeight="520"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#131720"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="16,20">
                <TextBlock Text="VALORANT"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="SETTINGS"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,1,0,14" />
                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,10" />

                <RadioButton x:Name="NavGeneral"
                             Content="General"
                             Style="{StaticResource NavRadio}"
                             GroupName="SettingsNav"
                             Tag="General"
                             IsChecked="True"
                             Checked="Nav_Checked" />
                <RadioButton x:Name="NavOverlay"
                             Content="Overlay"
                             Style="{StaticResource NavRadio}"
                             GroupName="SettingsNav"
                             Tag="Overlay"
                             Checked="Nav_Checked" />
                <RadioButton x:Name="NavShutdown"
                             Content="Shutdown"
                             Style="{StaticResource NavRadio}"
                             GroupName="SettingsNav"
                             Tag="Shutdown"
                             Checked="Nav_Checked" />
                <RadioButton x:Name="NavActivity"
                             Content="Activity"
                             Style="{StaticResource NavRadio}"
                             GroupName="SettingsNav"
                             Tag="Activity"
                             Checked="Nav_Checked" />

                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,10" />
                <TextBlock Text="Valorant Match Timer 2.0.1"
                           Style="{StaticResource MutedText}" />
                <TextBlock Text="MIT licensed · open source"
                           Style="{StaticResource MutedText}"
                           Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="26,22,26,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <ScrollViewer x:Name="PageGeneral" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="General" Style="{StaticResource SectionTitle}" />

                        <CheckBox x:Name="StartWithWindowsCheck"
                                  Content="Start with Windows"
                                  Style="{StaticResource Check}"
                                  Checked="StartWithWindows_Changed"
                                  Unchecked="StartWithWindows_Changed" />

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,14" />

                        <TextBlock Text="VALORANT LOG PATH" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="LogPathBox"
                                     Style="{StaticResource InputBox}"
                                     LostFocus="LogPathBox_LostFocus" />
                            <Button Grid.Column="1"
                                    Content="Browse..."
                                    Style="{StaticResource BaseButton}"
                                    Margin="8,0,0,0"
                                    Click="BrowseLog_Click" />
                        </Grid>
                        <TextBlock Text="Auto-detect reads ShooterGame.log. The get-off countdown works over any game."
                                   Style="{StaticResource HintText}"
                                   Margin="0,7,0,0" />

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,14" />

                        <TextBlock Text="WINDOW BEHAVIOR" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                        <TextBlock Text="The main window always behaves like a normal window and never pins above other apps. The overlay is separate and only appears over fullscreen games."
                                   Style="{StaticResource HintText}" />

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,14" />

                        <TextBlock Text="ABOUT" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                        <TextBlock Text="A small Windows timer for Valorant. It watches the local game log, learns match lengths, and gives you a shutdown warning before your get-off time."
                                   Style="{StaticResource HintText}" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="PageOverlay"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Overlay" Style="{StaticResource SectionTitle}" />

                        <CheckBox x:Name="OverlayEnabledCheck"
                                  Content="Enable overlay"
                                  Style="{StaticResource Check}"
                                  Checked="OverlayToggle_Changed"
                                  Unchecked="OverlayToggle_Changed" />
                        <CheckBox x:Name="OverlayAutoGameCheck"
                                  Content="Show only while a fullscreen game is focused"
                                  Style="{StaticResource Check}"
                                  Margin="0,9,0,0"
                                  Checked="OverlayToggle_Changed"
                                  Unchecked="OverlayToggle_Changed" />
                        <CheckBox x:Name="OverlayClickThroughCheck"
                                  Content="Click-through (locked)"
                                  Style="{StaticResource Check}"
                                  Margin="0,9,0,0"
                                  Checked="OverlayToggle_Changed"
                                  Unchecked="OverlayToggle_Changed" />
                        <TextBlock Text="Uncheck click-through to drag the overlay where you want it, then re-check it to lock it."
                                   Style="{StaticResource HintText}"
                                   Margin="0,6,0,0" />

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="62" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Opacity" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <Slider x:Name="OpacitySlider"
                                    Grid.Column="1"
                                    Minimum="0.2"
                                    Maximum="1.0"
                                    SmallChange="0.02"
                                    LargeChange="0.1"
                                    VerticalAlignment="Center"
                                    ValueChanged="OpacitySlider_ValueChanged" />
                            <TextBlock x:Name="OpacityValueText"
                                       Grid.Column="2"
                                       Text="92%"
                                       Style="{StaticResource MutedText}"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="62" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Scale" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <Slider x:Name="ScaleSlider"
                                    Grid.Column="1"
                                    Minimum="0.5"
                                    Maximum="2.0"
                                    SmallChange="0.05"
                                    LargeChange="0.25"
                                    VerticalAlignment="Center"
                                    ValueChanged="ScaleSlider_ValueChanged" />
                            <TextBlock x:Name="ScaleValueText"
                                       Grid.Column="2"
                                       Text="1.00x"
                                       Style="{StaticResource MutedText}"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="POSITION" Style="{StaticResource LabelText}" Margin="0,18,0,7" />
                        <WrapPanel x:Name="PositionPanel">
                            <RadioButton Content="Top left" Tag="top-left" Style="{StaticResource PillRadio}" Checked="Position_Checked" />
                            <RadioButton Content="Top center" Tag="top-center" Style="{StaticResource PillRadio}" Checked="Position_Checked" />
                            <RadioButton Content="Top right" Tag="top-right" Style="{StaticResource PillRadio}" Checked="Position_Checked" />
                            <RadioButton Content="Bottom left" Tag="bottom-left" Style="{StaticResource PillRadio}" Checked="Position_Checked" />
                            <RadioButton Content="Bottom center" Tag="bottom-center" Style="{StaticResource PillRadio}" Checked="Position_Checked" />
                            <RadioButton Content="Bottom right" Tag="bottom-right" Style="{StaticResource PillRadio}" Checked="Position_Checked" />
                            <RadioButton Content="Custom" Tag="custom" Style="{StaticResource PillRadio}" Checked="Position_Checked" />
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="X" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="PosXBox" Width="70" Style="{StaticResource InputBox}" TextAlignment="Center" />
                            <TextBlock Text="Y" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="14,0,6,0" />
                            <TextBox x:Name="PosYBox" Width="70" Style="{StaticResource InputBox}" TextAlignment="Center" />
                            <Button Content="Apply position"
                                    Style="{StaticResource BaseButton}"
                                    Margin="10,0,0,0"
                                    Click="ApplyPosition_Click" />
                        </StackPanel>

                        <TextBlock Text="SHOW" Style="{StaticResource LabelText}" Margin="0,18,0,7" />
                        <WrapPanel>
                            <CheckBox x:Name="ShowTimeCheck"
                                      Content="Get-off time"
                                      Style="{StaticResource Check}"
                                      Margin="0,0,18,7"
                                      Checked="OverlayToggle_Changed"
                                      Unchecked="OverlayToggle_Changed" />
                            <CheckBox x:Name="ShowMatchCheck"
                                      Content="Match info"
                                      Style="{StaticResource Check}"
                                      Margin="0,0,18,7"
                                      Checked="OverlayToggle_Changed"
                                      Unchecked="OverlayToggle_Changed" />
                            <CheckBox x:Name="ShowEndCheck"
                                      Content="Predicted end"
                                      Style="{StaticResource Check}"
                                      Margin="0,0,18,7"
                                      Checked="OverlayToggle_Changed"
                                      Unchecked="OverlayToggle_Changed" />
                            <CheckBox x:Name="ShowClockCheck"
                                      Content="Clock"
                                      Style="{StaticResource Check}"
                                      Margin="0,0,18,7"
                                      Checked="OverlayToggle_Changed"
                                      Unchecked="OverlayToggle_Changed" />
                        </WrapPanel>

                        <TextBlock Text="ACCENT" Style="{StaticResource LabelText}" Margin="0,12,0,7" />
                        <WrapPanel>
                            <Button Width="28" Height="28" Padding="0" Margin="0,0,6,0" Background="#FF4655" Style="{StaticResource BaseButton}" Tag="#FF4655" Click="AccentPreset_Click" />
                            <Button Width="28" Height="28" Padding="0" Margin="0,0,6,0" Background="#00E0A4" Style="{StaticResource BaseButton}" Tag="#00E0A4" Click="AccentPreset_Click" />
                            <Button Width="28" Height="28" Padding="0" Margin="0,0,6,0" Background="#4DA3FF" Style="{StaticResource BaseButton}" Tag="#4DA3FF" Click="AccentPreset_Click" />
                            <Button Width="28" Height="28" Padding="0" Margin="0,0,6,0" Background="#FFB020" Style="{StaticResource BaseButton}" Tag="#FFB020" Click="AccentPreset_Click" />
                            <Button Width="28" Height="28" Padding="0" Margin="0,0,6,0" Background="#FFFFFF" Style="{StaticResource BaseButton}" Tag="#FFFFFF" Click="AccentPreset_Click" />
                            <Button Width="28" Height="28" Padding="0" Margin="0,0,6,0" Background="#B55CFF" Style="{StaticResource BaseButton}" Tag="#B55CFF" Click="AccentPreset_Click" />
                            <TextBox x:Name="AccentBox" Width="92" Style="{StaticResource InputBox}" TextAlignment="Center" Margin="6,0,0,0" />
                            <Button Content="Apply" Style="{StaticResource BaseButton}" Margin="6,0,0,0" Click="AccentApply_Click" />
                        </WrapPanel>

                        <TextBlock Text="PREVIEW" Style="{StaticResource LabelText}" Margin="0,18,0,7" />
                        <Border x:Name="PreviewBorder"
                                Width="290"
                                HorizontalAlignment="Left"
                                Background="#10131A"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="2"
                                CornerRadius="9"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="GET OFF IN" FontSize="9" FontWeight="Bold" Foreground="#8B93A7" />
                                <TextBlock x:Name="PreviewTime"
                                           Text="1:23:45"
                                           FontFamily="Consolas"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="#E8EDF5" />
                                <TextBlock x:Name="PreviewMatch"
                                           Text="Competitive · ends 21:40"
                                           FontSize="10"
                                           Foreground="#8B93A7" />
                                <TextBlock x:Name="PreviewSub"
                                           Text="Get off at 23:00"
                                           FontSize="9"
                                           Foreground="#8B93A7"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="PageShutdown"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Shutdown" Style="{StaticResource SectionTitle}" />

                        <CheckBox x:Name="ShutdownAfterMatchCheck"
                                  Content="Ask to shut down when a manual timer ends"
                                  Style="{StaticResource Check}"
                                  Checked="ShutdownToggle_Changed"
                                  Unchecked="ShutdownToggle_Changed" />
                        <CheckBox x:Name="DeferShutdownCheck"
                                  Content="Wait for the match/OT to end before shutdown"
                                  Style="{StaticResource Check}"
                                  Margin="0,9,0,0"
                                  Checked="ShutdownToggle_Changed"
                                  Unchecked="ShutdownToggle_Changed" />

                        <TextBlock Text="WARNING LENGTH" Style="{StaticResource LabelText}" Margin="0,18,0,7" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="WarningMinutesBox"
                                     Width="64"
                                     Style="{StaticResource InputBox}"
                                     TextAlignment="Center"
                                     LostFocus="WarningMinutes_LostFocus" />
                            <TextBlock Text="minutes (1-15)"
                                       Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,14" />

                        <WrapPanel>
                            <Button Content="Test warning (10s)"
                                    Style="{StaticResource BaseButton}"
                                    Margin="0,0,8,8"
                                    Click="TestWarning_Click" />
                            <Button Content="Shutdown now..."
                                    Style="{StaticResource AccentButton}"
                                    Margin="0,0,8,8"
                                    Click="ShutdownNow_Click" />
                            <Button Content="Cancel pending shutdown"
                                    Style="{StaticResource BaseButton}"
                                    Margin="0,0,8,8"
                                    Click="CancelPending_Click" />
                        </WrapPanel>

                        <TextBlock Text="A shutdown never happens without the countdown window. If your cutoff is reached during a match, the app waits for that match and any overtime to finish before warning you."
                                   Style="{StaticResource HintText}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="PageActivity"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Activity" Style="{StaticResource SectionTitle}" />
                        <ListBox x:Name="ActivityList"
                                 Height="350"
                                 Background="{StaticResource InputBrush}"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1"
                                 FontFamily="Consolas"
                                 FontSize="11" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Clear activity"
                                    Style="{StaticResource BaseButton}"
                                    Margin="0,0,8,0"
                                    Click="ClearActivity_Click" />
                            <Button Content="Clear prediction history"
                                    Style="{StaticResource BaseButton}"
                                    Click="ClearHistory_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="1" Margin="0,14,0,0">
                <TextBlock x:Name="SavedText"
                           Text="Changes apply immediately."
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" />
                <Button Content="Close"
                        Style="{StaticResource AccentButton}"
                        HorizontalAlignment="Right"
                        Click="Close_Click" />
            </Grid>
        </Grid>
    </Grid>
</Window>
